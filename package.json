{
  "name": "tagnest",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "TagNest — a fast, keyboard-first bookmark manager built on Cloudflare",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --config vitest.backend.config.ts",
    "test:watch": "vitest --config vitest.backend.config.ts",
    "test:coverage": "vitest run --config vitest.backend.config.ts --coverage",
    "db:create": "wrangler d1 create tagnest-db",
    "db:migrate": "wrangler d1 migrations apply tagnest-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply tagnest-db --local",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --branch=preview",
    "deploy:check": "node scripts/deploy.mjs --dry-run",
    "release": "node scripts/deploy.mjs --push",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-virtual": "^3.11.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "happy-dom": "^16.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  }
}
